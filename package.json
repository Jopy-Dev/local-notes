{
  "name": "local-notes",
  "version": "0.1.0",
  "private": true,
  "description": "Offline, filesystem-first notes workspace served by a local Node.js/Fastify server with a React/Vite browser interface.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "verify:local": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@fastify/static": "9.1.3",
    "fastify": "5.9.0",
    "open": "11.0.0",
    "pino": "10.3.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.2",
    "@types/node": "22.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "10.6.0",
    "eslint-plugin-tailwindcss": "4.0.6",
    "pino-pretty": "13.1.3",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1",
    "vite": "8.1.3",
    "vitest": "4.1.9"
  }
}
