{
  "name": "local-notes",
  "version": "1.5.0",
  "private": true,
  "description": "Offline, filesystem-first notes workspace served by a local Node.js/Fastify server with a React/Vite browser interface.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "local-notes": "dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "dev:server": "vite-node src/cli/index.ts",
    "build": "vite build && npm run build:server",
    "build:server": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:package": "node scripts/test-package.mjs",
    "scan:predeploy": "bash scripts/scan-predeploy.sh",
    "test:coverage": "vitest run --coverage",
    "verify:local": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@codemirror/commands": "6.10.4",
    "@fastify/static": "9.1.3",
    "@orama/orama": "3.1.18",
    "chokidar": "5.0.0",
    "fastify": "5.9.0",
    "marked": "18.0.5",
    "open": "11.0.0",
    "pino": "10.3.1",
    "sanitize-html": "2.17.5",
    "trash": "10.1.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@codemirror/lang-markdown": "6.5.0",
    "@codemirror/search": "6.7.1",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.2",
    "@tanstack/react-virtual": "3.14.5",
    "@types/node": "22.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "2.16.1",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.9",
    "codemirror": "6.0.2",
    "eslint": "10.6.0",
    "eslint-plugin-tailwindcss": "4.0.6",
    "jsdom": "29.1.1",
    "pino-pretty": "13.1.3",
    "playwright": "1.61.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1",
    "vite": "8.1.3",
    "vite-node": "6.0.0",
    "vitest": "4.1.9",
    "zustand": "5.0.14"
  }
}
